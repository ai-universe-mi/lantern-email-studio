{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "file": {
      "type": "string"
    },
    "overall": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "stable kebab-case id, e.g. subject-too-long"
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "rule": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "rule",
          "location",
          "detail"
        ]
      }
    }
  },
  "required": [
    "file",
    "overall",
    "findings"
  ]
}
